# Supabase — same project as the Expo app
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Service role key — server-only. ALL admin reads/writes use this (it bypasses
# RLS). Never prefix with NEXT_PUBLIC; never used in the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Single shared password gating the whole admin tool.
ADMIN_PASSWORD=<choose-a-strong-password>

# Secret used to sign the auth cookie (any long random string).
ADMIN_COOKIE_SECRET=<random-long-string>

# Path to the Expo app's bundled data (for seeding + reference usage tables).
# Local dev only; for Vercel the needed JSON is copied into the repo (see notes).
APP_DATA_DIR=../fahim-quran-app/assets/data
