# Supabase — same project as the Expo app
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Service role key — server-only. ALL admin reads/writes use this (it bypasses
# RLS). Never prefix with NEXT_PUBLIC; never used in the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Single shared password gating the whole admin tool.
ADMIN_PASSWORD=<choose-a-strong-password>

# Secret used to sign the auth cookie (any long random string).
ADMIN_COOKIE_SECRET=<random-long-string>

# Path to the Expo app's bundled data (for seeding + reference usage tables).
# Local dev only; for Vercel the needed JSON is copied into the repo (see notes).
APP_DATA_DIR=../fahim-quran-app/assets/data

# OpenRouter — powers the "Suggest corrections" button on tashreef pages. One key,
# any model (Claude / GPT / Gemini / …). Get a key at https://openrouter.ai/keys.
# Server-only; never prefix with NEXT_PUBLIC.
OPENROUTER_API_KEY=<openrouter-api-key>

# Default model slug used when the UI doesn't override it. Any slug from
# https://openrouter.ai/models works, e.g. anthropic/claude-3.5-sonnet,
# openai/gpt-4o, google/gemini-2.0-flash-001.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: sent as the OpenRouter HTTP-Referer attribution header.
OPENROUTER_SITE_URL=https://fahimna-admin
